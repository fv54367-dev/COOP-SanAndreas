#!/bin/sh
# commit-msg: valida que el asunto tenga prefijo (convencion anti-pisada de AGENTS.md).
#
# Uso: lo instala tools/instalar_hooks.ps1 (git config core.hooksPath .githooks).
#
# Por defecto AVISA y deja pasar el commit: con 1162 commits historicos, 667 sin
# prefijo, bloquear de golpe seria una trampa. Con COOP_STRICT_COMMITS=1 rechaza.
#
# Prefijos validos: feat fix refactor net docs test chore perf revert build ci
# Forma: "<prefijo>: <asunto>" o "<prefijo>(<area>): <asunto>" o "<prefijo>!: <asunto>"

msgfile="$1"
[ -n "$msgfile" ] || exit 0
subject=$(sed -n '1p' "$msgfile")

# los mensajes automaticos de git no llevan prefijo
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

if printf '%s' "$subject" | grep -Eq '^(feat|fix|refactor|net|docs|test|chore|perf|revert|build|ci)(\([^)]+\))?!?: .+'; then
    exit 0
fi

echo ''
echo '  [commit-msg] El asunto no tiene prefijo.'
echo '  Convencion (AGENTS.md): feat: | fix: | refactor: | net: | docs: | test: | chore:'
echo "  Asunto: $subject"
echo ''
if [ "${COOP_STRICT_COMMITS:-0}" = "1" ]; then
    echo '  COOP_STRICT_COMMITS=1: commit RECHAZADO.'
    exit 1
fi
echo '  (aviso: el commit sigue. Para bloquear: export COOP_STRICT_COMMITS=1)'
exit 0
